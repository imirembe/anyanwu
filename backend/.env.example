# Copy to backend/.env and configure your chosen hosted inference endpoints.
# Nothing is downloaded and no paid provider is contacted until configured.
ANYANWU_HOST=127.0.0.1
ANYANWU_PORT=8787
# Required for any non-loopback deployment. Set a long random token.
ANYANWU_ACCESS_TOKEN=

# Voice-first milestone: configure ASR and TTS below; TEXT can stay blank.
# The backend then speaks labelled prepared replies for speech evaluation.
# Chat-completions-compatible JSON endpoint. Models must be evaluated for Igbo.
ANYANWU_TEXT_URL=
ANYANWU_TEXT_KEY=
ANYANWU_TEXT_MODEL=

# Multilingual transcription endpoint: model, response_format=json,
# with automatic recognition of Igbo, English, and mixed Igbo/English speech.
# file. Expected response: {"text":"Igbo transcript"}.
ANYANWU_ASR_URL=
ANYANWU_ASR_KEY=
ANYANWU_ASR_MODEL=

# Speech-compatible JSON endpoint: model, voice, input, response_format=mp3.
# Must return audio with an audio/mpeg, audio/mp4 or audio/wav type.
ANYANWU_TTS_URL=
ANYANWU_TTS_KEY=
ANYANWU_TTS_MODEL=
ANYANWU_TTS_VOICE=

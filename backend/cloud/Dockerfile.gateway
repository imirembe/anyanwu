FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements-api.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && useradd --uid 10001 --create-home anyanwu
COPY backend /app/backend
USER 10001:10001
EXPOSE 8787
CMD ["python", "-m", "uvicorn", "backend.gateway:create_app", "--factory", "--host", "0.0.0.0", "--port", "8787", "--workers", "1", "--no-access-log", "--timeout-keep-alive", "5"]

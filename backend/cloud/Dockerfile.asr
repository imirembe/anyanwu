FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf TORCH_HOME=/models/torch XDG_CACHE_HOME=/models/cache \
    FAIRSEQ2_CACHE_DIR=/models/fairseq2 HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 OMP_NUM_THREADS=2 MPLCONFIGDIR=/tmp/matplotlib ANYANWU_AUDIO_TMP=/tmp \
    HOME=/home/anyanwu NUMBA_CACHE_DIR=/models/numba TRITON_CACHE_DIR=/models/triton
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-api.txt /app/requirements-api.txt
COPY backend/inference/requirements-asr.txt /app/requirements-asr.txt
RUN pip install --no-cache-dir 'torchaudio==2.8.0' --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir 'fairseq2[arrow]==0.6.0' --extra-index-url https://fair.pkg.atmeta.com/fairseq2/whl/pt2.8.0/cu128 \
    && pip install --no-cache-dir -r /app/requirements-api.txt -r /app/requirements-asr.txt \
    && pip check \
    && useradd --uid 10001 --create-home anyanwu \
    && mkdir /models && chown 10001:10001 /models
COPY backend /app/backend
USER 10001:10001
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "backend.inference.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log", "--timeout-keep-alive", "5"]
